{
  "name": "depotpro-mobile-premium",
  "version": "1.0.0",
  "private": true,
  "description": "DEPOTPRO MOBILE PREMIUM — React Native + TypeScript + moteur Rust, offline-first fr-CI/FCFA",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:android": "bash scripts/build-rust-android.sh",
    "rust:ios": "bash scripts/build-rust-ios.sh",
    "bundle:check": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/depotpro-android.bundle --assets-dest /tmp/depotpro-assets"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@tanstack/react-query": "^5.108.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-keychain": "^11.0.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "codegenConfig": {
    "name": "DepotCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.depotpro.mobile"
    }
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
